#!/bin/sh
# bin/kaboom-agentic-browser — POSIX exec shim for the Kaboom Agentic Browser server.
#
# MCP mode (default): execs the Go binary, REPLACING this shell's process image.
# No launcher process survives, so there is nothing to orphan when the MCP client
# goes away. The previous Node launcher blocked in execFileSync, could not react to
# signals, and was reparented to PID 1 when its parent (npx) died — that leaked
# ~36 MB of idle Node runtime per session, permanently.
#
# CLI mode (--install, --doctor, ...): execs Node for lib/cli/cli.js, which owns the
# install/config/doctor flows the Go binary does not implement.
#
# Binary resolution mirrors lib/runtime/resolve-binary.js and is enforced by
# tests/cli/contracts/launcher-shim.contract.test.cjs. PATH is never consulted.

set -u

# --- Resolve this script's real directory (npm links node_modules/.bin as a symlink) ---
SELF="$0"
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in
    /*) SELF="$link" ;;
    *) SELF="$(dirname "$SELF")/$link" ;;
  esac
done
BIN_DIR=$(cd -P "$(dirname "$SELF")" && pwd)
PKG_DIR=$(cd -P "$BIN_DIR/.." && pwd)
LIB_DIR="$PKG_DIR/lib"

# --- CLI commands are Node's job; hand the process over and stop here ---
for arg in "$@"; do
  case "$arg" in
    --config|-c|--install|-i|--update|--doctor|--connect|--uninstall|--help|-h|--version|-v)
      exec node "$LIB_DIR/cli/cli.js" "$@"
      ;;
  esac
done

# --- MCP server mode ---

# Report a resolution failure as a JSON-RPC error so the MCP client shows a
# protocol error instead of a process that vanished without explanation.
fail() {
  printf '%s\n' "$1" >&2
  printf '{"jsonrpc":"2.0","id":null,"error":{"code":-32603,"message":"%s","data":{"isError":true}}}\n' "$1"
  exit 1
}

case "$(uname -s)" in
  Darwin) PLATFORM=darwin; EXT= ;;
  Linux)  PLATFORM=linux;  EXT= ;;
  # Git Bash / MSYS2 / Cygwin: npm's generated .cmd shim runs this script through sh.
  MINGW*|MSYS*|CYGWIN*) PLATFORM=win32; EXT=.exe ;;
  *) fail "Unsupported platform: $(uname -s). Kaboom ships binaries for darwin, linux, and win32." ;;
esac

case "$(uname -m)" in
  arm64|aarch64) ARCH=arm64 ;;
  x86_64|amd64)  ARCH=x64 ;;
  *) fail "Unsupported architecture: $(uname -m). Kaboom ships x64 and arm64 binaries." ;;
esac

# No arm64 Windows build ships; the x64 binary runs there under emulation.
[ "$PLATFORM" = "win32" ] && ARCH=x64

PLATFORM_KEY="$PLATFORM-$ARCH"
PKG_NAME="@brennhill/kaboom-agentic-browser-$PLATFORM_KEY"
BIN_NAME="kaboom-agentic-browser$EXT"

# 1. Explicit operator override. Set but missing is a real failure, not a fallthrough.
if [ -n "${KABOOM_BINARY_PATH:-}" ]; then
  [ -x "$KABOOM_BINARY_PATH" ] || fail "KABOOM_BINARY_PATH is set to '$KABOOM_BINARY_PATH' but no executable exists there."
  exec "$KABOOM_BINARY_PATH" "$@"
fi

# 2. Source-tree dist build. The package dir's parent is 'npm' in the repo and
# 'node_modules' once installed, so a dist/ planted in a user's project is unreachable.
if [ "$(basename "$(dirname "$PKG_DIR")")" = "npm" ]; then
  DEV_BIN="$PKG_DIR/../../dist/kaboom-agentic-browser-$PLATFORM_KEY$EXT"
  [ -x "$DEV_BIN" ] && exec "$DEV_BIN" "$@"
fi

# 3. The platform optionalDependency, at the depths npm may place it.
for candidate in \
  "$PKG_DIR/node_modules/$PKG_NAME/bin/$BIN_NAME" \
  "$PKG_DIR/../$PKG_NAME/bin/$BIN_NAME" \
  "$PKG_DIR/../../$PKG_NAME/bin/$BIN_NAME"
do
  [ -x "$candidate" ] && exec "$candidate" "$@"
done

fail "Kaboom binary not found for $PLATFORM_KEY. Expected the platform package $PKG_NAME, which installs as an optionalDependency. Repair: npm install -g kaboom-agentic-browser@latest (without --no-optional). To point at a binary yourself, set KABOOM_BINARY_PATH."
