#!/usr/bin/env node

// bin/kaboom-hooks — Cross-platform launcher for the kaboom-hooks binary.
// Finds the Go hooks binary from platform-specific npm packages and spawns it.

const { execFileSync } = require('child_process')
const path = require('path')
const fs = require('fs')
const os = require('os')

const KABOOM_VERSION = require('../package.json').version

function detectPlatform() {
  const platformMap = { darwin: 'darwin', linux: 'linux', win32: 'win32' }
  const archMap = { x64: 'x64', arm64: 'arm64' }

  const platform = platformMap[process.platform]
  const arch = archMap[process.arch]

  if (!platform || !arch) return null

  const ext = process.platform === 'win32' ? '.exe' : ''
  const effectiveArch = (platform === 'win32') ? 'x64' : arch
  const platformKey = `${platform}-${effectiveArch}`
  const binaryName = `kaboom-hooks${ext}`
  const pkgName = `@brennhill/kaboom-agentic-browser-${platformKey}`

  return { platformKey, binaryName, pkgName, ext }
}

function findHooksBinary(info) {
  const scriptDir = __dirname

  // 1. Dev build — gated behind KABOOM_DEV so it can only fire in this repo, never in a
  //    consumer install tree (where '../../../dist' resolves into the consumer's project).
  if (process.env.KABOOM_DEV === '1') {
    for (const name of [`kaboom-hooks-${info.platformKey}${info.ext}`, `kaboom-hooks${info.ext}`]) {
      const devBin = path.join(scriptDir, '..', '..', '..', 'dist', name)
      if (fs.existsSync(devBin)) return devBin
    }
  }

  // 2. node_modules candidates — the normal npm path.
  const candidates = [
    path.join(scriptDir, '..', 'node_modules', info.pkgName, 'bin', info.binaryName),
    path.join(scriptDir, '..', '..', info.pkgName, 'bin', info.binaryName),
    path.join(scriptDir, '..', '..', '..', info.pkgName, 'bin', info.binaryName),
  ]
  for (const candidate of candidates) {
    if (fs.existsSync(candidate)) return candidate
  }

  // 3. Managed install location only (~/.kaboom/bin), version-matched — never an arbitrary
  //    kaboom-hooks on PATH (the previous fallback exec'd any PATH match, entirely unverified).
  try {
    const managed = path.join(os.homedir(), '.kaboom', 'bin', info.binaryName)
    if (fs.existsSync(managed)) {
      const verOut = execFileSync(managed, ['--version'], { encoding: 'utf8', timeout: 5000, stdio: ['pipe', 'pipe', 'pipe'] })
      const verMatch = verOut.match(/(\d+\.\d+\.\d+)/)
      if (verMatch && verMatch[1] === KABOOM_VERSION) return managed
    }
  } catch {
    // Managed binary absent or unversioned — fall through to the not-found error.
  }

  return null
}

const info = detectPlatform()
if (!info) {
  console.error(`Unsupported platform: ${process.platform}-${process.arch}`)
  process.exit(1)
}

const binary = findHooksBinary(info)
if (!binary) {
  console.error(`kaboom-hooks binary not found for ${info.platformKey}. Try reinstalling: npm install -g kaboom-agentic-browser@latest`)
  process.exit(1)
}

try {
  execFileSync(binary, process.argv.slice(2), { stdio: 'inherit', windowsHide: false })
} catch (e) {
  process.exit(e.status ?? 1)
}
