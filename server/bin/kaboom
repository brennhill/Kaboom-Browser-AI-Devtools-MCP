#!/bin/sh
# bin/kaboom — POSIX exec shim for the kaboom-agentic-browser binary.
#
# Execs the binary that scripts/install.js downloads into this directory,
# REPLACING this shell's process image. No launcher process survives, so there is
# nothing to orphan when the MCP client goes away.
#
# This replaced a Node launcher that blocked in execFileSync: it could not act on
# signals aimed at the process group, and when its parent died it was reparented
# to PID 1 with no signal delivered and no stdin EOF to unwind it.
#
# Binary name must match scripts/install.js: kaboom-agentic-browser-<plat>-<arch>.

set -u

SELF="$0"
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in
    /*) SELF="$link" ;;
    *) SELF="$(dirname "$SELF")/$link" ;;
  esac
done
BIN_DIR=$(cd -P "$(dirname "$SELF")" && pwd)

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

case "$(uname -s)" in
  Darwin) PLATFORM=darwin; EXT= ;;
  Linux)  PLATFORM=linux;  EXT= ;;
  MINGW*|MSYS*|CYGWIN*) PLATFORM=win32; EXT=.exe ;;
  *) fail "Unsupported platform: $(uname -s)" ;;
esac

case "$(uname -m)" in
  arm64|aarch64) ARCH=arm64 ;;
  x86_64|amd64)  ARCH=x64 ;;
  *) fail "Unsupported architecture: $(uname -m)" ;;
esac

BINARY="$BIN_DIR/kaboom-agentic-browser-$PLATFORM-$ARCH$EXT"

[ -x "$BINARY" ] || fail "Binary not found: $BINARY
Run \"npm install kaboom-agentic-browser\" to download the binary for your platform."

exec "$BINARY" "$@"
