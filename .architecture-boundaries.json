{
  "max_exports_per_file": 24,
  "enforce_zero_cycles": true,
  "forbid_reexports": true,
  "forbidden_source_files": ["src/types/index.ts", "src/background/index.ts", "src/background/ui/tab-state.ts"],
  "forbidden_import_suffixes": ["types/index.js", "background/index.js", "background/ui/tab-state.js"],
  "canonical_type_owners": {
    "TrackingState": "src/types/runtime/tracking.ts",
    "TrackingStateChangedMessage": "src/types/runtime/tracking.ts",
    "GetTrackingStateResponse": "src/types/runtime/tracking.ts"
  },
  "export_exceptions": {
    "src/lib/constants.ts": {
      "max": 64,
      "reason": "Canonical extension-wide constants and storage keys."
    },
    "src/types/runtime-messages.ts": {
      "max": 56,
      "reason": "Canonical cross-context runtime message contract."
    },
    "src/types/utils.ts": {
      "max": 52,
      "reason": "Canonical shared utility type declarations."
    },
    "src/content/ui/terminal-widget-types.ts": {
      "max": 37,
      "reason": "Canonical terminal state and timing contract."
    }
  },
  "forbidden_imports": {
    "background": ["content", "inject", "popup", "offscreen"],
    "content": ["background", "inject", "popup", "offscreen"],
    "inject": ["background", "content", "popup", "offscreen"],
    "lib": ["background", "content", "inject", "popup", "offscreen"],
    "offscreen": ["background", "content", "inject", "popup"],
    "popup": ["background", "content", "inject", "offscreen"]
  },
  "context_entry_points": {
    "src/background/recording/": {
      "context": "Screen Recording",
      "public": ["index.ts", "utils.ts"],
      "reason": "Live screen recording lifecycle (start, restore, stop) is owned by recording/index.ts; utils.ts holds shared pure helpers. See GLOSSARY.md."
    },
    "src/background/commands/": {
      "context": "Browser Command Execution",
      "public": ["registry.ts", "helpers.ts"],
      "reason": "Commands are reached through registerCommand/dispatch and the shared target/result helpers; per-family handler modules stay private. See GLOSSARY.md."
    }
  }
}
